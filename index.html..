<!DOCTYPE html>
<html lang="bs">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Demo plaćanje</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #eef1f5;

            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 92%;
            max-width: 420px;

            background: white;

            padding: 28px;

            border-radius: 16px;

            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        }

        .warning {
            background: #fff3cd;

            border: 1px solid #ffda6a;

            color: #664d03;

            padding: 12px;

            border-radius: 10px;

            margin-bottom: 20px;

            font-size: 14px;
        }

        h1 {
            text-align: center;
        }

        .amount {
            text-align: center;

            font-size: 25px;

            font-weight: bold;

            margin: 20px 0;
        }

        label {
            display: block;

            margin-top: 15px;

            margin-bottom: 6px;

            font-weight: bold;
        }

        input {
            width: 100%;

            padding: 13px;

            border: 1px solid #ccc;

            border-radius: 8px;

            font-size: 16px;
        }

        button {
            width: 100%;

            padding: 14px;

            margin-top: 22px;

            border: none;

            border-radius: 8px;

            background: #1769e0;

            color: white;

            font-size: 16px;

            cursor: pointer;
        }

        button:hover {
            background: #0d55bd;
        }

        #result {
            display: none;

            margin-top: 20px;

            padding: 15px;

            border-radius: 10px;

            background: #d1e7dd;

            color: #0f5132;
        }

        .footer {
            text-align: center;

            margin-top: 20px;

            font-size: 12px;

            color: #777;
        }

    </style>
</head>


<body>

<div class="container">

    <div class="warning">

        ⚠️ <strong>ŠKOLSKA SIMULACIJA</strong>

        <br><br>

        Ovo je demonstracija QR-code phishinga.

        Nikakvi podaci se ne šalju niti čuvaju.

    </div>


    <h1>💳 Plaćanje</h1>


    >

        

    </div>


    <form id="paymentForm">


        <label for="cardNumber">

            Broj kartice

        </label>


        <input

            id="cardNumber"

            type="text"

            inputmode="numeric"

            maxlength="19"

            placeholder="XXXX XXXX XXXX XXXX"

            autocomplete="off"

        >


        <label for="cardName">

            Ime na kartici

        </label>


        <input

            id="cardName"

            type="text"

            placeholder="IME PREZIME"

            autocomplete="off"

        >


        <label for="cvv">

            CVV

        </label>


        <input

            id="cvv"

            type="text"

            inputmode="numeric"

            maxlength="3"

            placeholder="XXX"

            autocomplete="off"

        >


        <button type="submit">

            Plati

        </button>


    </form>
    <div id="result">

        <strong>🎓 Demonstracija završena.</strong>

        <br><br>

       

        <br><br>

        <strong>.</strong>

    </div>


    <div class="footer">

        Školski projekat — QR phishing awareness

    </div>

</div>


<script>

const form = document.getElementById("paymentForm");

const result = document.getElementById("result");


form.addEventListener("submit", function(event) {

    event.preventDefault();

    /*
       Ovo je namjerno samo simulacija.

       Nema servera za primanje podataka.
       Nema fetch() zahtjeva.
       Nema spremanja podataka.
    */

    form.style.display = "none";

    result.style.display = "block";

});

</script>


</body>

</html>
